{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luae RPG",
  "version": "0.2.6",
  "identifier": "br.luaerpg.studio",
  "build": {
    "frontendDist": "../build/diana/editor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "Luae RPG",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../build/diana/runtime/": "runtime/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": ["msi", "nsis"]
  }
}
