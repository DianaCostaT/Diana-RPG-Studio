+
+// Diana stores arbitrary walking grids in System.json rather than filenames.
+Game_CharacterBase.dianaSpriteAnimation = function(name) {
+    const library = $dataSystem?.dianaSpriteAnimations;
+    const grid = library?.version === 1 && library.characters?.[String(name || "")];
+    const animation = grid?.animations?.walk;
+    const validCell = cell => Number.isInteger(cell) && cell >= 0 && cell < grid.columns * grid.rows;
+    if (!grid || !Number.isInteger(grid.columns) || !Number.isInteger(grid.rows) ||
+            grid.columns < 1 || grid.rows < 1 || !Array.isArray(animation?.frames) ||
+            !animation.frames.length || !animation.frames.every(validCell) ||
+            !Number.isInteger(animation.speed) || animation.speed < 1 ||
+            ![true, false, "once"].includes(animation.loop)) return null;
+    return grid;
+};
+
+Game_CharacterBase.prototype.dianaWalkAnimation = function() {
+    return Game_CharacterBase.dianaSpriteAnimation(this._characterName)?.animations.walk || null;
+};
+
