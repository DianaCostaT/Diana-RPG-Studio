+Game_CharacterBase.prototype.updatePattern = function() {
+    const animation = this.dianaWalkAnimation();
+    if (!animation) return _dianaGridUpdatePattern.call(this);
+    if (this.hasStepAnime() || this.hasWalkAnime()) {
+        this._pattern++;
+        if (this._pattern >= animation.frames.length) this._pattern = animation.loop === true ? 0 : animation.frames.length - 1;
+    } else {
+        this.resetPattern();
+    }
+};
+
+const _dianaGridResetPattern = Game_CharacterBase.prototype.resetPattern;
+Game_CharacterBase.prototype.resetPattern = function() {
+    if (this.dianaWalkAnimation()) this.setPattern(0);
+    else _dianaGridResetPattern.call(this);
+};
+
+const _dianaGridIsOriginalPattern = Game_CharacterBase.prototype.isOriginalPattern;
+Game_CharacterBase.prototype.isOriginalPattern = function() {
