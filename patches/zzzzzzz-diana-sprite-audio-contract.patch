+Game_CharacterBase.prototype.maxPattern = function() {
+    return this.dianaWalkAnimation()?.frames.length || _dianaGridMaxPattern.call(this);
+};
+
+const _dianaGridPattern = Game_CharacterBase.prototype.pattern;
+Game_CharacterBase.prototype.pattern = function() {
+    return this.dianaWalkAnimation() ? this._pattern : _dianaGridPattern.call(this);
+};
+
+const _dianaGridAnimationWait = Game_CharacterBase.prototype.animationWait;
+Game_CharacterBase.prototype.animationWait = function() {
