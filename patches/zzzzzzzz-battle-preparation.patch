+            `Heróis (${artifact.counts.party}): ${artifact.party.map(actor => `#${actor.actorId} ${actor.name || 'AUSENTE'} Nv.${actor.level}; equip. ${actor.equips.join(',') || 'nenhum'} [${state(actor.asset)}]`).join('; ') || '(nenhum)'}.`,
