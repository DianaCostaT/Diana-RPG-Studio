+    _assetState(folder, name) {
+        if (!name) return { state: 'not-selected', path: null };
+        const relative = `img/${folder}/${name}`;
+        if (!window.RRAssetFiles?.findImage || !this.project?.path) return { state: 'unverified', path: relative };
+        const path = require('path');
+        return { state: window.RRAssetFiles.findImage(path.join(this.project.path, 'img', folder), name) ? 'valid' : 'missing', path: relative };
+    }
+
+    _battlerAsset(kind, record) {
+        if (!record) return { state: 'missing', path: null };
+        const config = this.databaseManager.data?.battlePresentation?.[kind]?.[record.id]?.graphic;
+        if (config?.mode === 'model') return { state: config.model ? 'not-applicable' : 'missing', path: config.model || null };
+        const folder = config?.mode === 'character' ? (config.folder || 'characters') : config?.mode === 'static' ? (config.folder || (kind === 'actors' ? 'sv_actors' : 'enemies')) : kind === 'actors' ? 'sv_actors' : 'enemies';
+        return this._assetState(folder, config?.mode && config.mode !== 'auto' ? config.name : record.battlerName);
+    }
+
+    preparedArtifact() {
+        const troop = this.databaseManager.getTroop?.(Number(this.troopId));
+        const party = this.battlers.map(battler => {
+            const actor = this.databaseManager.getActor?.(Number(battler.actorId));
+            const asset = this._battlerAsset('actors', actor);
+            return { actorId: Number(battler.actorId) || 0, name: actor?.name || null, level: Number(battler.level) || 1, equips: (battler.equips || []).map(id => Number(id) || 0), asset, valid: !!actor };
+        });
+        const enemies = (troop?.members || []).map((member, index) => {
+            const enemy = this.databaseManager.getEnemy?.(Number(member.enemyId));
+            const asset = this._battlerAsset('enemies', enemy);
+            return { index: index + 1, enemyId: Number(member.enemyId) || 0, name: enemy?.name || null, x: Number(member.x) || 0, y: Number(member.y) || 0, hidden: !!member.hidden, asset, valid: !!enemy };
+        });
+        const backgrounds = {
+            battleback1: { name: this.battleback1Name || '', ...this._assetState('battlebacks1', this.battleback1Name) },
+            battleback2: { name: this.battleback2Name || '', ...this._assetState('battlebacks2', this.battleback2Name) }
+        };
+        const issues = [];
+        if (!troop) issues.push(`Grupo #${Number(this.troopId) || 0} não existe.`);
+        if (troop && !enemies.length) issues.push(`Grupo #${Number(this.troopId)} não possui inimigos.`);
+        for (const actor of party) if (!actor.valid) issues.push(`Herói #${actor.actorId} não existe.`);
+        for (const enemy of enemies) if (!enemy.valid) issues.push(`Inimigo #${enemy.enemyId} não existe.`);
+        for (const [key, background] of Object.entries(backgrounds)) if (background.state === 'missing') issues.push(`${key === 'battleback1' ? 'Fundo inferior' : 'Fundo superior'} ausente: ${background.path}.`);
+        return { version: 1, troopId: Number(this.troopId) || 0, troopName: troop?.name || null, backgrounds, party, enemies, counts: { party: party.length, enemies: enemies.length }, valid: issues.length === 0 && party.some(actor => actor.valid), issues };
+    }
+
+    persistPreparation() {
+        const system = this.databaseManager?.getSystem?.();
+        if (!system) return;
+        system.testBattlers = JSON.parse(JSON.stringify(this.battlers));
+        system.testTroopId = Number(this.troopId) || 0;
+        system.dianaBattlePreparation = this.preparedArtifact();
+        this.databaseManager.markDirty?.('system');
+    }
